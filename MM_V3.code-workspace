{
  "folders": [
    {
      "name": "Root",
      "path": "."
    },
    {
      "name": "Frontend",
      "path": "./frontend"
    },
    {
      "name": "Backend",
      "path": "./backend"
    },
    {
      "name": "mm-squad-trips",
      "path": "./lovable_pages/mm-squad-trips"
    },
    {
      "name": "parents-voucher",
      "path": "./parents-voucher"
    },
    {
      "path": "madventure-travel"
    }
  ],
  "settings": {
    "git.enabled": true,
    "git.autoRepositoryDetection": true,
    "git.scanRepositories": [
      ".",
      "./frontend",
      "./backend",
      "./lovable_pages/mm-squad-trips",
      "./parents-voucher"
    ],
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/dist/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/dist": true
    },
    "typescript.preferences.importModuleSpecifier": "relative",
    "java.configuration.updateBuildConfiguration": "automatic",
    "liveServer.settings.multiRootWorkspaceName": "Frontend"
  }
}


